# Aura Sync Gateway - Environment Configuration Example
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For local SQLite/mock fallback, leave DATABASE_URL blank or comment out
DATABASE_URL=postgresql://aura_user:your_secure_password_here@localhost:5432/aura_db

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
